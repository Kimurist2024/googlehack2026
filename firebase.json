{
  "hosting": {
    "public": "web",
    "ignore": ["**/.*"],
    "rewrites": [
      {
        "source": "/v1/**",
        "run": {
          "serviceId": "mushitori",
          "region": "asia-northeast1"
        }
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8681
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
