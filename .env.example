# 実際の値は .env に書く。.env はコミットしない
APP_ENV=local
SERVE_WEB=1
# 32文字以上のランダムな文字列
SESSION_SECRET=
# local は合成データ専用で、生徒のコードを隔離せずに動かす。本番は code_execution
SANDBOX_BACKEND=local
ALLOW_LOCAL_SANDBOX=1
# template か gemini
AI_BACKEND=template
# memory は手元の開発専用で、再起動すると消える。指定がなければ firestore を使う
STORE_BACKEND=memory
GOOGLE_CLOUD_PROJECT=mushitori-hackathon
SANDBOX_LOCATION=asia-northeast1
GEMINI_MODEL=gemini-3.5-flash-lite
# 本番で教員として許可するメールアドレス（カンマ区切り）
TEACHER_EMAILS=
