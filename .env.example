# 実際の値は .env に書く。.env はコミットしない
APP_ENV=local
SERVE_WEB=1
# 32文字以上のランダムな文字列
SESSION_SECRET=
# local は合成データ専用で、生徒のコードを隔離せずに動かす。本番は code_execution
SANDBOX_BACKEND=local
ALLOW_LOCAL_SANDBOX=1
# template か gemini
AI_BACKEND=template
# memory は手元の開発専用で、再起動すると消える。指定がなければ firestore を使う
STORE_BACKEND=memory
GOOGLE_CLOUD_PROJECT=mushitori-hackathon
SANDBOX_LOCATION=asia-northeast1
GEMINI_MODEL=gemini-3.5-flash-lite
# 本番で教員として許可するメールアドレス（カンマ区切り）
TEACHER_EMAILS=
# 1 にすると、本番でもログインした教員が合成データのデモクラスを作れる
ALLOW_DEMO_SEED=
# Gemini に渡す文と返答を検査する Model Armor のテンプレート。本番で AI_BACKEND=gemini なら必須
# 例: projects/mushitori-hackathon/locations/us/templates/mushitori-guard
MODEL_ARMOR_TEMPLATE=
# 日本語を検査するための多言語の検出。asia-northeast1 のテンプレートを使うときは 0
MODEL_ARMOR_MULTI_LANGUAGE=1
# 生徒のデータを残す日数（1〜365）。課題を作った時点から数える
RETENTION_DAYS=30
# X-Forwarded-For の右から何個を信用するか。Cloud Run の上では指定しなくても 1 になる
# TRUSTED_PROXY_HOPS=1
# 1 にすると、ログアウトや無効化で失効した教員のトークンも断る。サービスアカウントに roles/firebaseauth.viewer が要る
FIREBASE_CHECK_REVOKED=
# 授業パッケージに署名する Cloud KMS の鍵のバージョン（EC_SIGN_P256_SHA256）。本番で授業パッケージを作るなら必須
# 例: projects/mushitori-hackathon/locations/asia-northeast1/keyRings/mushitori/cryptoKeys/class-package/cryptoKeyVersions/1
PACKAGE_SIGNING_KMS_KEY=
# --- 校内LAN版（教員PC）だけで使う。ふつうは scripts/lan.py が設定する ---
# DEPLOY_MODE=lan
# PACKAGE_PUBLIC_KEY_FILE=~/.mushitori/package-key.pem
# LAN_DATA_DIR=~/.mushitori
